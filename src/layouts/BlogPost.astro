---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

type Heading = {
	depth: number;
	slug: string;
	text: string;
};

type PaginationPost = {
	description: string;
	href: string;
	title: string;
};

type Props = CollectionEntry<"blog">["data"] & {
	headings?: Heading[];
	groupHref: string;
	groupName: string;
	nextPost?: PaginationPost;
	previousPost?: PaginationPost;
	readingTime?: string;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	headings = [],
	groupHref,
	groupName,
	nextPost,
	previousPost,
	readingTime,
} = Astro.props;

const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const hasToc = tocHeadings.length > 0;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			:root {
				--doc-bg: var(--site-bg);
				--doc-surface: var(--site-surface);
				--doc-text: var(--site-text);
				--doc-heading: var(--site-heading);
				--doc-muted: var(--site-muted);
				--doc-soft: var(--site-soft);
				--doc-rule: var(--site-border);
				--doc-rule-strong: var(--site-border-strong);
				--doc-active: var(--site-active);
				--doc-code-bg: #f5f6f8;
				--doc-code-border: var(--site-border);
				--doc-link: var(--site-link);
			}

			:root[data-theme="dark"] {
				--doc-code-bg: #050506;
				--doc-code-border: #292a2e;
			}

			* {
				box-sizing: border-box;
			}

			body {
				margin: 0;
				min-width: 320px;
				background: var(--doc-bg);
				color: var(--doc-text);
				font-family:
					"Helvetica Neue", -apple-system, BlinkMacSystemFont, "SF Pro Text", Arial, sans-serif;
				-webkit-font-smoothing: antialiased;
				text-rendering: optimizeLegibility;
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			button {
				font: inherit;
			}

			.doc-post {
				display: grid;
				grid-template-columns: minmax(230px, 290px) minmax(0, 760px);
				gap: clamp(48px, 7vw, 96px);
				margin: 0 auto;
				max-width: 1180px;
				min-height: 100vh;
				padding: clamp(32px, 6vw, 76px) clamp(24px, 5vw, 64px);
			}

			.doc-index {
				border-right: 1px solid var(--doc-rule);
			}

			.doc-index-inner {
				display: flex;
				flex-direction: column;
				max-height: calc(100vh - var(--site-header-height) - 48px);
				min-height: 0;
				overflow: hidden;
				padding-right: 28px;
				position: sticky;
				top: calc(var(--site-header-height) + 30px);
			}

			.doc-kicker,
			.doc-section-label {
				color: var(--doc-soft);
				font-size: 0.78rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				margin: 0;
				text-transform: uppercase;
			}

			.doc-title-link {
				color: var(--doc-heading);
				display: block;
				font-size: clamp(1.55rem, 2.6vw, 2.2rem);
				font-weight: 760;
				letter-spacing: 0;
				line-height: 1.06;
				margin-top: 12px;
			}

			.doc-description {
				color: var(--doc-muted);
				font-size: 0.98rem;
				line-height: 1.5;
				margin: 18px 0 0;
			}

			.doc-group-link {
				margin: 14px 0 0;
			}

			.doc-group-link a {
				color: var(--doc-heading);
				font-size: 0.95rem;
				font-weight: 700;
				text-decoration: none;
			}

			.doc-meta {
				color: var(--doc-soft);
				font-size: 0.9rem;
				line-height: 1.45;
				margin: 16px 0 0;
			}

			.doc-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
				margin-top: 18px;
			}

			.doc-tag {
				border: 1px solid var(--doc-rule);
				border-radius: 999px;
				color: var(--doc-muted);
				font-size: 0.78rem;
				font-weight: 650;
				padding: 4px 9px;
			}

			.doc-menu {
				column-gap: 14px;
				display: grid;
				flex: 1;
				grid-template-columns: 2px minmax(0, 1fr);
				margin-top: 30px;
				min-height: 0;
			}

			.doc-progress {
				background: var(--doc-rule);
				border-radius: 999px;
				overflow: hidden;
				width: 2px;
			}

			.doc-progress span {
				background: var(--doc-heading);
				border-radius: inherit;
				display: block;
				height: 0;
				transition: height 180ms ease;
				width: 100%;
			}

			.doc-section-nav {
				display: grid;
				gap: 2px;
				max-height: 100%;
				min-height: 0;
				overflow-y: auto;
				padding-right: 6px;
				scrollbar-gutter: stable;
			}

			.doc-section-nav a {
				background: transparent;
				border-radius: 8px;
				color: var(--doc-muted);
				display: block;
				font-size: 0.98rem;
				font-weight: 650;
				line-height: 1.2;
				padding: 10px 12px;
				transition:
					background-color 160ms ease,
					color 160ms ease;
			}

			.doc-section-nav a[data-depth="3"] {
				font-size: 0.92rem;
				padding-left: 24px;
			}

			.doc-section-nav a:hover,
			.doc-section-nav a.active {
				background: var(--doc-active);
				color: var(--doc-heading);
			}

			.doc-section-nav a:focus {
				outline: none;
			}

			.doc-section-nav a:focus-visible {
				box-shadow: 0 0 0 2px var(--doc-link);
			}

			.doc-article {
				min-width: 0;
				padding-bottom: 20vh;
			}

			.doc-hero {
				border-bottom: 1px solid var(--doc-rule);
				margin-bottom: clamp(42px, 6vw, 70px);
				padding-bottom: clamp(34px, 5vw, 56px);
			}

			.doc-breadcrumb {
				align-items: center;
				color: var(--doc-soft);
				display: flex;
				flex-wrap: wrap;
				font-size: 0.82rem;
				font-weight: 700;
				gap: 0.48rem;
				letter-spacing: 0.06em;
				text-transform: uppercase;
			}

			.doc-breadcrumb a {
				color: inherit;
			}

			.doc-hero h1 {
				color: var(--doc-heading);
				font-size: clamp(3rem, 7vw, 6.4rem);
				font-weight: 760;
				letter-spacing: 0;
				line-height: 0.95;
				margin: 14px 0 0;
				max-width: 10ch;
			}

			.doc-hero-meta {
				color: var(--doc-soft);
				display: flex;
				flex-wrap: wrap;
				font-size: 1rem;
				gap: 0.45rem;
				margin-top: 24px;
			}

			.doc-hero-image {
				margin-top: 34px;
			}

			.doc-hero-image img {
				border: 1px solid var(--doc-rule);
				border-radius: 14px;
				display: block;
				height: auto;
				width: 100%;
			}

			.doc-content {
				color: var(--doc-text);
			}

			.doc-pagination {
				display: grid;
				gap: 16px;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				margin-top: clamp(56px, 8vw, 88px);
			}

			.doc-pagination-card {
				background: var(--doc-surface);
				border: 1px solid var(--doc-rule);
				border-radius: 16px;
				display: grid;
				gap: 10px;
				min-height: 164px;
				padding: 20px;
				transition:
					border-color 160ms ease,
					transform 160ms ease;
			}

			.doc-pagination-card:hover {
				border-color: var(--doc-rule-strong);
				transform: translateY(-2px);
			}

			.doc-pagination-card[data-align="end"] {
				text-align: right;
			}

			.doc-pagination-label {
				color: var(--doc-soft);
				font-size: 0.78rem;
				font-weight: 760;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}

			.doc-pagination-card strong {
				color: var(--doc-heading);
				font-size: 1.15rem;
				line-height: 1.25;
			}

			.doc-pagination-card p {
				color: var(--doc-muted);
				font-size: 0.94rem;
				line-height: 1.5;
				margin: 0;
			}

			.doc-pagination-spacer {
				display: block;
			}

			.doc-content :global(*) {
				scroll-margin-top: 38px;
			}

			.doc-content :global(h2) {
				color: var(--doc-heading);
				font-size: clamp(1.95rem, 3.2vw, 3rem);
				font-weight: 740;
				letter-spacing: 0;
				line-height: 1.06;
				margin: clamp(52px, 7vw, 84px) 0 22px;
			}

			.doc-content :global(h2:first-child) {
				margin-top: 0;
			}

			.doc-content :global(h3) {
				color: var(--doc-heading);
				font-size: clamp(1.42rem, 2.2vw, 2rem);
				font-weight: 720;
				letter-spacing: 0;
				line-height: 1.16;
				margin: 42px 0 18px;
			}

			.doc-content :global(p),
			.doc-content :global(li) {
				font-size: clamp(1.08rem, 1.45vw, 1.24rem);
				letter-spacing: 0;
				line-height: 1.62;
			}

			.doc-content :global(p) {
				margin: 0 0 20px;
			}

			.doc-content :global(ul),
			.doc-content :global(ol) {
				margin: 0 0 24px 1.35em;
				padding: 0;
			}

			.doc-content :global(li) {
				margin: 0.45em 0;
				padding-left: 0.1em;
			}

			.doc-content :global(blockquote) {
				background: var(--doc-surface);
				border: 1px solid var(--doc-rule);
				border-radius: 14px;
				color: var(--doc-muted);
				font-size: clamp(1.08rem, 1.45vw, 1.22rem);
				line-height: 1.55;
				margin: 30px 0;
				padding: 24px;
			}

			.doc-content :global(blockquote p:last-child) {
				margin-bottom: 0;
			}

			.doc-content :global(a) {
				color: var(--doc-link);
				text-decoration: underline;
				text-underline-offset: 0.16em;
			}

			.doc-content :global(img) {
				border-radius: 12px;
				display: block;
				height: auto;
				margin: 32px auto;
				max-width: 100%;
			}

			.doc-content :global(:not(pre) > code) {
				background: var(--doc-active);
				border: 1px solid var(--doc-rule);
				border-radius: 5px;
				color: var(--doc-heading);
				font-family: "SF Mono", Menlo, Consolas, monospace;
				font-size: 0.88em;
				padding: 0.12em 0.34em;
			}

			.doc-content :global(pre) {
				background: var(--doc-code-bg) !important;
				border: 1px solid var(--doc-code-border);
				border-radius: 14px;
				margin: 30px 0;
				overflow-x: auto;
				padding: 20px;
			}

			.doc-content :global(.code-frame) {
				background: var(--doc-code-bg);
				border: 1px solid var(--doc-code-border);
				border-radius: 14px;
				margin: 30px 0;
				overflow: hidden;
			}

			.doc-content :global(.code-frame pre) {
				border: 0;
				border-radius: 0;
				margin: 0;
			}

			:global(.code-frame-header) {
				align-items: center;
				background: var(--doc-surface);
				border-bottom: 1px solid var(--doc-code-border);
				display: flex;
				justify-content: space-between;
				min-height: 46px;
				padding: 0 12px 0 16px;
			}

			:global(.code-language) {
				align-items: center;
				color: var(--doc-muted);
				display: inline-flex;
				font-size: 0.88rem;
				font-weight: 700;
				gap: 8px;
				min-width: 0;
			}

			:global(.code-language iconify-icon) {
				color: var(--doc-muted);
				flex: 0 0 auto;
				font-size: 1.1rem;
			}

			:global(.code-language iconify-icon[hidden]) {
				display: none;
			}

			:global(.code-copy) {
				appearance: none;
				background: var(--doc-active);
				border: 1px solid var(--doc-rule);
				border-radius: 999px;
				color: var(--doc-heading);
				cursor: pointer;
				font-size: 0.82rem;
				font-weight: 700;
				min-width: 68px;
				padding: 6px 12px;
				white-space: nowrap;
			}

			:global(.code-copy:hover) {
				border-color: var(--doc-rule-strong);
			}

			.doc-content :global(pre code) {
				background: transparent;
				color: inherit;
				font-family: "SF Mono", Menlo, Consolas, monospace;
				font-size: 0.9rem;
				line-height: 1.55;
			}

			:root[data-theme="light"] .doc-content :global(.astro-code),
			:root[data-theme="light"] .doc-content :global(.astro-code span) {
				background-color: var(--doc-code-bg) !important;
				color: var(--shiki-light) !important;
			}

			:root[data-theme="dark"] .doc-content :global(.astro-code),
			:root[data-theme="dark"] .doc-content :global(.astro-code span) {
				background-color: var(--doc-code-bg) !important;
				color: var(--shiki-dark) !important;
			}

			@media (max-width: 860px) {
				.doc-post {
					display: block;
					padding: 24px 20px 72px;
				}

				.doc-index {
					background: color-mix(in srgb, var(--doc-bg) 92%, transparent);
					border-bottom: 1px solid var(--doc-rule);
					border-right: 0;
					margin: 0 -20px 40px;
					padding: 18px 20px 16px;
					position: sticky;
					top: var(--site-header-height);
					z-index: 2;
				}

				.doc-index-inner {
					max-height: none;
					overflow: visible;
					padding-right: 0;
					position: static;
				}

				.doc-description,
				.doc-meta,
				.doc-tags,
				.doc-progress {
					display: none;
				}

				.doc-title-link {
					font-size: 1.3rem;
					margin-top: 6px;
				}

				.doc-menu {
					display: block;
					flex: none;
					margin-top: 14px;
				}

				.doc-section-nav {
					display: flex;
					gap: 10px;
					max-height: none;
					overflow-y: visible;
					overflow-x: auto;
					padding-bottom: 2px;
					padding-right: 0;
				}

				.doc-section-nav a {
					flex: 0 0 auto;
					padding: 8px 10px;
				}

				.doc-section-nav a[data-depth="3"] {
					padding-left: 10px;
				}

				.doc-hero h1 {
					font-size: clamp(2.8rem, 16vw, 4.2rem);
					max-width: 10ch;
				}

				.doc-pagination {
					grid-template-columns: 1fr;
				}

				.doc-pagination-card[data-align="end"] {
					text-align: left;
				}

				.doc-pagination-spacer {
					display: none;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<div class="doc-post">
			<aside class="doc-index" aria-label="Article navigation">
				<div class="doc-index-inner">
					<p class="doc-kicker">Article</p>
					<a class="doc-title-link" href="#top" data-doc-top>{title}</a>
					<p class="doc-group-link">
						<a href={groupHref}>{groupName}</a>
					</p>
					<p class="doc-description">{description}</p>
					<p class="doc-meta">
						<FormattedDate date={pubDate} />
						{readingTime && <> · {readingTime}</>}
						{
							updatedDate && (
								<>
									<br />
									Updated <FormattedDate date={updatedDate} />
								</>
							)
						}
					</p>
					{
						tags.length > 0 && (
							<div class="doc-tags" aria-label="Tags">
								{tags.map((tag) => (
									<span class="doc-tag">{tag}</span>
								))}
							</div>
						)
					}
					{
						hasToc && (
							<div class="doc-menu">
								<div class="doc-progress" aria-hidden="true" data-progress>
									<span data-progress-fill />
								</div>

								<nav class="doc-section-nav" data-section-nav>
									{tocHeadings.map((heading) => (
										<a href={`#${heading.slug}`} data-depth={heading.depth}>
											{heading.text}
										</a>
									))}
								</nav>
							</div>
						)
					}
				</div>
			</aside>

			<article class="doc-article" id="top">
				<header class="doc-hero">
					<nav class="doc-breadcrumb" aria-label="Breadcrumb">
						<a href="/blog">Blog</a>
						<span>/</span>
						<a href={groupHref}>{groupName}</a>
					</nav>
					<h1>{title}</h1>
					<div class="doc-hero-meta">
						<span><FormattedDate date={pubDate} /></span>
						{readingTime && <span>· {readingTime}</span>}
					</div>
					{
						heroImage && (
							<div class="doc-hero-image">
								<Image width={1400} height={700} src={heroImage} alt="" />
							</div>
						)
					}
				</header>

				<div class="doc-content">
					<slot />
				</div>

				{
					(previousPost || nextPost) && (
						<nav class="doc-pagination" aria-label="Article pagination">
							{previousPost ? (
								<a class="doc-pagination-card" href={previousPost.href}>
									<span class="doc-pagination-label">Previous</span>
									<strong>{previousPost.title}</strong>
									<p>{previousPost.description}</p>
								</a>
							) : (
								<div class="doc-pagination-spacer" aria-hidden="true" />
							)}

							{nextPost ? (
								<a class="doc-pagination-card" data-align="end" href={nextPost.href}>
									<span class="doc-pagination-label">Next</span>
									<strong>{nextPost.title}</strong>
									<p>{nextPost.description}</p>
								</a>
							) : (
								<div class="doc-pagination-spacer" aria-hidden="true" />
							)}
						</nav>
					)
				}
			</article>
		</div>
		<Footer />

		<script is:inline data-astro-rerun>
			(() => {
				window.__blogPostCleanup?.();

				function ensureIconify() {
					if (window.customElements?.get("iconify-icon")) {
						return;
					}

					if (document.querySelector('script[data-iconify-loader="blog"]')) {
						return;
					}

					const script = document.createElement("script");
					script.src = "https://code.iconify.design/iconify-icon/3.0.0/iconify-icon.min.js";
					script.async = true;
					script.dataset.iconifyLoader = "blog";
					document.head.append(script);
				}

				const cleanup = [];
				const on = (target, type, handler, options) => {
					target?.addEventListener(type, handler, options);
					cleanup.push(() => target?.removeEventListener(type, handler, options));
				};

				ensureIconify();

				const sectionNav = document.querySelector("[data-section-nav]");
				const topLink = document.querySelector("[data-doc-top]");
				const progressFill = document.querySelector("[data-progress-fill]");
				const links = sectionNav ? Array.from(sectionNav.querySelectorAll("a[href^='#']")) : [];
				const sections = links
					.map((link) => ({
						id: decodeURIComponent(link.hash.slice(1)),
						link,
						element: document.getElementById(decodeURIComponent(link.hash.slice(1))),
					}))
					.filter((item) => item.element);
				let activeId = "";
				let scrollLockUntil = 0;
				let scrollFrame = 0;

				const languageNames = {
					js: "JavaScript",
					jsx: "React JSX",
					ts: "TypeScript",
					tsx: "React TSX",
					md: "Markdown",
					mdx: "MDX",
					sh: "Shell",
					bash: "Bash",
					zsh: "Zsh",
					py: "Python",
					go: "Go",
					rs: "Rust",
					json: "JSON",
					yaml: "YAML",
					yml: "YAML",
					toml: "TOML",
					text: "Text",
					txt: "Text",
				};

				const iconAliases = {
					bash: "shell",
					sh: "shell",
					zsh: "shell",
					txt: "text",
					yml: "yaml",
				};

				function languageLabel(language) {
					return languageNames[language] || language.toUpperCase();
				}

				function copyText(text, callback) {
					let copied = false;

					const finish = (success) => {
						callback(success);
					};

					if (navigator.clipboard && window.isSecureContext) {
						navigator.clipboard
							.writeText(text)
							.then(() => finish(true))
							.catch(() => fallbackCopy());
						return;
					}

					fallbackCopy();

					function fallbackCopy() {
						const textarea = document.createElement("textarea");
						textarea.value = text;
						textarea.setAttribute("readonly", "");
						textarea.style.position = "fixed";
						textarea.style.top = "-999px";
						document.body.appendChild(textarea);
						textarea.select();

						try {
							copied = document.execCommand("copy");
						} catch {
							copied = false;
						} finally {
							document.body.removeChild(textarea);
						}

						finish(copied);
					}
				}

				function enhanceCodeBlocks() {
					document.querySelectorAll(".doc-content pre.astro-code[data-language]").forEach((pre) => {
						if (pre.parentElement?.classList.contains("code-frame")) {
							return;
						}

						const language = pre.dataset.language || "text";
						const frame = document.createElement("div");
						const header = document.createElement("div");
						const languageNode = document.createElement("span");
						const icon = document.createElement("iconify-icon");
						const label = document.createElement("span");
						const copy = document.createElement("button");

						frame.className = "code-frame";
						header.className = "code-frame-header";
						languageNode.className = "code-language";
						icon.setAttribute("icon", `catppuccin:${iconAliases[language] || language}`);
						icon.setAttribute("aria-hidden", "true");
						label.textContent = languageLabel(language);
						copy.className = "code-copy";
						copy.type = "button";
						copy.textContent = "Copy";

						on(icon, "error", () => {
							icon.hidden = true;
						});

						on(copy, "click", () => {
							copyText(pre.innerText, (success) => {
								copy.textContent = success ? "Copied" : "Copy failed";
								window.setTimeout(() => {
									copy.textContent = "Copy";
								}, success ? 1400 : 1800);
							});
						});

						languageNode.append(icon, label);
						header.append(languageNode, copy);
						pre.before(frame);
						frame.append(header, pre);
					});
				}

				function setActive(id, updateHash = true) {
					if (!id || activeId === id) {
						return;
					}

					activeId = id;
					const index = sections.findIndex((item) => item.id === id);

					sections.forEach((item) => {
						item.link.classList.toggle("active", item.id === id);
						item.link.toggleAttribute("aria-current", item.id === id);
					});

					if (progressFill && index >= 0) {
						progressFill.style.height = `${((index + 1) / sections.length) * 100}%`;
					}

					if (updateHash && window.location.hash !== `#${id}`) {
						window.history.replaceState(null, "", `#${id}`);
					}
				}

				function sectionFromHash() {
					const id = decodeURIComponent(window.location.hash.slice(1));
					return sections.some((item) => item.id === id) ? id : sections[0]?.id;
				}

				function sectionFromScroll() {
					const marker = window.scrollY + Math.min(window.innerHeight * 0.34, 320);
					let current = sections[0]?.id;

					for (const item of sections) {
						if (item.element.offsetTop <= marker) {
							current = item.id;
						}
					}

					return current;
				}

				function syncFromScroll() {
					if (Date.now() < scrollLockUntil || sections.length === 0) {
						return;
					}

					if (scrollFrame) {
						window.cancelAnimationFrame(scrollFrame);
					}

					scrollFrame = window.requestAnimationFrame(() => {
						setActive(sectionFromScroll());
					});
				}

				function navigateTo(id, target) {
					const section = sections.find((item) => item.id === id);

					if (!section) {
						return;
					}

					target?.blur();
					scrollLockUntil = Date.now() + 900;
					setActive(id);
					section.element.scrollIntoView({ behavior: "smooth", block: "start" });
				}

				enhanceCodeBlocks();

				links.forEach((link) => {
					on(link, "click", (event) => {
						event.preventDefault();
						navigateTo(decodeURIComponent(link.hash.slice(1)), link);
					});
				});

				on(topLink, "click", (event) => {
					event.preventDefault();
					topLink.blur();
					scrollLockUntil = Date.now() + 900;
					window.history.replaceState(null, "", window.location.pathname);
					window.scrollTo({ top: 0, behavior: "smooth" });
					setActive(sections[0]?.id, false);
				});

				on(window, "hashchange", () => setActive(sectionFromHash(), false));
				on(window, "scroll", syncFromScroll, { passive: true });
				setActive(sectionFromHash(), false);
				syncFromScroll();

				window.__blogPostCleanup = () => {
					if (scrollFrame) {
						window.cancelAnimationFrame(scrollFrame);
					}
					cleanup.splice(0).forEach((fn) => fn());
				};
			})();
		</script>
	</body>
</html>
