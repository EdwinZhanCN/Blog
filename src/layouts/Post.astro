---
import "../styles/prose.css";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { STATUS, type Status } from "../consts";
import { formatDate, splitTitle } from "../utils/blog";
import Base from "./Base.astro";

type Heading = { depth: number; slug: string; text: string };
type Neighbour = { href: string; title: string; n: number; seed: number };

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata | "" | null;
	status?: Status | null;
	lang?: string | null;
	headings?: Heading[];
	groupName: string;
	groupHref: string;
	position: number;
	total: number;
	previous?: Neighbour;
	next?: Neighbour;
	readingTime: string;
	seed: number;
	slug: string;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	status,
	lang,
	headings = [],
	groupName,
	groupHref,
	position,
	total,
	previous,
	next,
	readingTime,
	seed,
	slug,
} = Astro.props;

const { main } = splitTitle(title);
const top = Math.min(...headings.map((heading) => heading.depth), 2);
const toc = headings
	.filter((heading) => heading.depth <= top + 1)
	.map((heading) => ({ ...heading, depth: heading.depth - top + 2 }));
const state = status ? STATUS[status] : undefined;
const revised = updatedDate && updatedDate.valueOf() !== pubDate.valueOf() ? updatedDate : undefined;
// A real image wins; an unfilled template placeholder doesn't count as one.
const picture = heroImage && !/blog-placeholder/.test(heroImage.src) ? heroImage : undefined;
const pad = (value: number) => String(value).padStart(2, "0");
---

<Base title={main} description={description || main} type="article">
	<div class="progress" data-progress aria-hidden="true"></div>

	<article class="post page">
		<header class="post-head wrap">
			<nav class="crumbs label" aria-label="Breadcrumb">
				<a href="/blog/">Writing</a>
				<span aria-hidden="true">/</span>
				<a href={groupHref}>{groupName}</a>
				<span class="crumbs-n">{pad(position)} of {pad(total)}</span>
			</nav>

			<div class="post-head-grid">
				<div class="post-head-text">
					<h1 class="post-title" data-reveal="words">{main}</h1>
					{description && <p class="post-desc" lang={lang ?? "zh-Hans"} data-reveal data-delay="0.35">{description}</p>}
					<dl class="post-meta label" data-reveal data-delay="0.5">
						<div>
							<dt>Published</dt>
							<dd><time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></dd>
						</div>
						{
							revised && (
								<div>
									<dt>Revised</dt>
									<dd><time datetime={revised.toISOString()}>{formatDate(revised)}</time></dd>
								</div>
							)
						}
						<div>
							<dt>Reading</dt>
							<dd>{readingTime.replace(" read", "")}</dd>
						</div>
						{
							state && (
								<div>
									<dt>State</dt>
									<dd>{state.label}</dd>
								</div>
							)
						}
					</dl>
				</div>

				<figure class="post-cover" data-reveal data-delay="0.2">
					<div class="sheet">
						{
							picture ? (
								<Image src={picture} alt="" width={720} />
							) : (
								<canvas data-cover={seed} aria-hidden="true" />
							)
						}
					</div>
					{!picture && <figcaption class="label">Seed {String(seed).padStart(5, "0")} · grown from this note’s name</figcaption>}
				</figure>
			</div>

			{
				state && status !== "inked" && (
					<p class="post-state">
						<span class="label">{state.label}</span>
						{state.note}
					</p>
				)
			}
		</header>

		<div class="post-body wrap">
			<div class="prose" data-prose lang={lang ?? "zh-Hans"}>
				<slot />
				<p class="end" lang="en"><span class="seal" aria-hidden="true"></span>End of note</p>
			</div>

			{
				toc.length > 1 && (
					<aside class="toc" data-toc lang={lang ?? "zh-Hans"}>
						<p class="label" lang="en">Contents</p>
						<ol>
							{toc.map((heading) => (
								<li data-depth={heading.depth}>
									<a href={`#${heading.slug}`}>{heading.text}</a>
								</li>
							))}
						</ol>
					</aside>
				)
			}
		</div>

		<nav class="post-nav wrap" aria-label={`More in ${groupName}`}>
			{
				previous ? (
					<a class="post-nav-link" href={previous.href} data-peek={previous.seed}>
						<span class="label">← {pad(previous.n)} · Previous</span>
						<span class="post-nav-title">{previous.title}</span>
					</a>
				) : (
					<a class="post-nav-link" href={groupHref}>
						<span class="label">← Series</span>
						<span class="post-nav-title">{groupName}</span>
					</a>
				)
			}
			{
				next ? (
					<a class="post-nav-link is-next" href={next.href} data-peek={next.seed}>
						<span class="label">Next · {pad(next.n)} →</span>
						<span class="post-nav-title">{next.title}</span>
					</a>
				) : (
					<a class="post-nav-link is-next" href="/blog/">
						<span class="label">All writing →</span>
						<span class="post-nav-title">Back to the index</span>
					</a>
				)
			}
		</nav>
	</article>
</Base>

<style>
	.progress {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 60;
		height: 2px;
		background: var(--fg);
		transform: scaleX(0);
		transform-origin: 0 50%;
	}

	.crumbs {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px;
		padding-bottom: clamp(28px, 4vw, 48px);
	}

	.crumbs a:hover {
		color: var(--fg);
	}

	.crumbs-n {
		margin-left: auto;
	}

	.post-head-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) clamp(220px, 26vw, 400px);
		align-items: end;
		gap: clamp(28px, 5vw, 80px);
		padding-bottom: clamp(36px, 5vw, 64px);
		border-bottom: 1px solid var(--line-strong);
	}

	.post-title {
		max-width: 16em;
		font-size: clamp(2.25rem, 5.6vw, 5.25rem);
		font-weight: 600;
		line-height: 0.98;
		letter-spacing: -0.045em;
		text-wrap: balance;
	}

	.post-desc {
		max-width: 34em;
		margin-top: clamp(18px, 2.4vw, 32px);
		font-family: var(--font-serif);
		font-size: clamp(1.125rem, 1.7vw, 1.375rem);
		line-height: 1.6;
		letter-spacing: 0;
		color: var(--fg-2);
		text-autospace: normal;
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 18px 40px;
		margin-top: clamp(28px, 4vw, 52px);
	}

	.post-meta dt {
		color: var(--fg-3);
	}

	.post-meta dd {
		margin-top: 6px;
		color: var(--fg);
	}

	.post-cover .sheet {
		aspect-ratio: 1;
	}

	.post-cover :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.post-cover figcaption {
		margin-top: 10px;
		color: var(--fg-3);
	}

	.post-state {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 8px 16px;
		padding-block: 18px;
		border-bottom: 1px solid var(--line);
		font-family: var(--font-serif);
		font-size: 1.125rem;
		font-style: italic;
		color: var(--fg-2);
	}

	.post-state .label {
		padding: 4px 9px 3px;
		border-radius: 980px;
		box-shadow: inset 0 0 0 1px var(--line-strong);
		font-style: normal;
	}

	.post-body {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 46rem) minmax(0, 1fr);
		padding-top: clamp(40px, 6vw, 88px);
	}

	.post-body .prose {
		grid-column: 2;
		min-width: 0;
	}

	.toc {
		grid-column: 3;
		grid-row: 1;
		position: sticky;
		top: 104px;
		align-self: start;
		justify-self: end;
		width: min(100%, 15rem);
		max-height: calc(100svh - 150px);
		padding-left: 24px;
		overflow-y: auto;
		scrollbar-width: none;
	}

	.toc ol {
		margin-top: 16px;
		border-left: 1px solid var(--line);
	}

	.toc li a {
		display: block;
		margin-left: -1px;
		padding: 5px 0 5px 14px;
		border-left: 1px solid transparent;
		font-size: 0.8125rem;
		line-height: 1.4;
		color: var(--fg-3);
		transition:
			color 0.3s,
			border-color 0.3s;
	}

	.toc li[data-depth="3"] a {
		padding-left: 26px;
	}

	.toc li a:hover {
		color: var(--fg);
	}

	.toc li a[aria-current] {
		border-left-color: var(--fg);
		color: var(--fg);
	}

	.post-nav {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		margin-top: clamp(72px, 10vw, 144px);
		border-top: 1px solid var(--line-strong);
	}

	.post-nav-link {
		display: grid;
		align-content: start;
		gap: 14px;
		padding: clamp(22px, 3vw, 40px) clamp(16px, 2vw, 32px) clamp(28px, 4vw, 56px) 0;
		transition: opacity 0.4s;
	}

	.post-nav-link.is-next {
		padding-left: clamp(16px, 2vw, 32px);
		padding-right: 0;
		border-left: 1px solid var(--line);
		text-align: right;
	}

	.post-nav-title {
		font-size: clamp(1.25rem, 2.6vw, 2.25rem);
		font-weight: 600;
		line-height: 1.08;
		letter-spacing: -0.035em;
		text-wrap: balance;
	}

	.post-nav:hover .post-nav-link:not(:hover) {
		opacity: 0.35;
	}

	@media (max-width: 1180px) {
		.toc {
			display: none;
		}
	}

	@media (max-width: 760px) {
		.post-head-grid {
			grid-template-columns: 1fr;
			align-items: start;
		}

		.post-cover {
			order: -1;
			width: min(62%, 280px);
		}

		.post-nav {
			grid-template-columns: 1fr;
		}

		.post-nav-link.is-next {
			padding-left: 0;
			border-left: 0;
			border-top: 1px solid var(--line);
			text-align: left;
		}
	}
</style>
