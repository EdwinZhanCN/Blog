---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Post from "../../layouts/Post.astro";
import {
	formatGroupName,
	getGroupHref,
	getPostGroupName,
	getPostHref,
	getPublishedPosts,
	seedFor,
	sortPostsByOrder,
	splitTitle,
} from "../../utils/blog";
import { estimateReadingTime } from "../../utils/readingTime";

export async function getStaticPaths() {
	// Drafts get a page while you're writing (npm run dev) and none once the site is built.
	const posts = (await getCollection("blog")).filter((post) => import.meta.env.DEV || !post.data.draft);
	return posts.map((post) => ({
		params: { slug: post.id.toLowerCase() },
		props: post,
	}));
}

type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content, headings } = await render(post);
const groupName = getPostGroupName(post);
const siblings = sortPostsByOrder(
	getPublishedPosts(await getCollection("blog")).filter((entry) => getPostGroupName(entry) === groupName),
);
const index = siblings.findIndex((entry) => entry.id === post.id);
const neighbour = (offset: number) => {
	const entry = index >= 0 ? siblings[index + offset] : undefined;
	return (
		entry && {
			href: getPostHref(entry),
			title: splitTitle(entry.data.title).main,
			n: index + offset + 1,
			seed: seedFor(entry.id.toLowerCase()),
		}
	);
};
---

<Post
	{...post.data}
	headings={headings}
	groupName={formatGroupName(groupName)}
	groupHref={getGroupHref(groupName)}
	position={index >= 0 ? index + 1 : 1}
	total={Math.max(siblings.length, 1)}
	previous={neighbour(-1)}
	next={neighbour(1)}
	readingTime={estimateReadingTime(post.body ?? "")}
	seed={seedFor(post.id.toLowerCase())}
	slug={post.id.toLowerCase()}
>
	<Content />
</Post>
