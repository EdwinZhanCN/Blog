---
import { getCollection } from "astro:content";
import PostRow from "../../components/PostRow.astro";
import Base from "../../layouts/Base.astro";
import { getGroupHref, getPublishedPosts, groupPosts, sortPostsByDate } from "../../utils/blog";

const posts = sortPostsByDate(getPublishedPosts(await getCollection("blog")));
const groups = groupPosts(posts);
const years = [...new Set(posts.map((post) => post.data.pubDate.getUTCFullYear()))];
const count = (value: number) => String(value).padStart(2, "0");
---

<Base title="Writing" description="Every note on the site, newest first.">
	<div class="page wrap">
		<header class="page-head">
			<p class="label" data-reveal>Writing · {count(posts.length)} notes · {count(groups.length)} series</p>
			<h1 class="page-title" data-reveal="words">Notes, <span class="serif">kept.</span></h1>
			<p class="page-lede" data-reveal data-delay="0.3">
				Written close to the projects they came from. Mostly in Chinese. Some of them unfinished.
			</p>
		</header>

		<nav class="series-nav" aria-label="Series" data-reveal data-delay="0.4">
			{
				groups.map((group) => (
					<a class="chip" href={getGroupHref(group.name)}>
						{group.label}
						<span>{count(group.posts.length)}</span>
					</a>
				))
			}
		</nav>

		{
			years.map((year) => {
				const inYear = posts.filter((post) => post.data.pubDate.getUTCFullYear() === year);
				return (
					<section class="year" aria-labelledby={`y${year}`}>
						<h2 class="year-n" id={`y${year}`}>
							{year}
						</h2>
						<div class="rows">
							{inYear.map((post, index) => (
								<PostRow post={post} index={inYear.length - index} detail />
							))}
						</div>
					</section>
				);
			})
		}
	</div>
</Base>

<style>
	.series-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		padding-bottom: clamp(40px, 6vw, 80px);
	}

	.chip {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		height: 38px;
		padding: 0 16px;
		border-radius: 980px;
		box-shadow: inset 0 0 0 1px var(--line-strong);
		font-size: 0.875rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		transition:
			background 0.35s var(--ease-out),
			color 0.35s var(--ease-out);
	}

	.chip span {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--fg-3);
		transition: color 0.35s;
	}

	.chip:hover {
		background: var(--ink);
		color: var(--paper);
	}

	.chip:hover span {
		color: inherit;
	}

	.year + .year {
		margin-top: clamp(56px, 8vw, 112px);
	}

	.year-n {
		padding-bottom: 14px;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		color: var(--fg-2);
	}
</style>
