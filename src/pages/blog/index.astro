---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import { getGroupHref, groupPosts } from "../../utils/blog";

const groups = groupPosts((await getCollection("blog")).filter((post) => !post.data.draft));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="page-shell">
			<section class="page-hero">
				<p class="eyebrow">Blog</p>
				<h1>Technical notes with the implementation left in.</h1>
				<p class="lead">
					Long-form posts on inference systems, runtime boundaries, and project decisions that are
					easier to reason about once they have a shape on the page.
				</p>
			</section>

			<section class="page-section" aria-label="Folders">
				<ul class="post-grid">
					{
						groups.map((group) => (
							<li>
								<a
									class:list={["post-card", group.posts.length > 5 && "has-preview-overflow"]}
									href={getGroupHref(group.name)}
								>
									<p class="post-meta">
										{group.label} · {group.posts.length} {group.posts.length === 1 ? "post" : "posts"}
									</p>
									<h2>{group.label}</h2>
									<p>{group.posts[0]?.data.description}</p>
									<div class="card-list-preview">
										<ul class="card-list" aria-label={`${group.label} posts`}>
											{group.posts.slice(0, 5).map((post) => (
												<li>
													<span>{post.data.order}.</span>
													<span>{post.data.title}</span>
												</li>
											))}
										</ul>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
