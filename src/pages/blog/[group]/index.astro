---
import type { BlogGroup } from "../../../utils/blog";
import { getCollection } from "astro:content";
import BaseHead from "../../../components/BaseHead.astro";
import Footer from "../../../components/Footer.astro";
import FormattedDate from "../../../components/FormattedDate.astro";
import Header from "../../../components/Header.astro";
import { SITE_TITLE } from "../../../consts";
import { getPostHref, groupPosts } from "../../../utils/blog";

export async function getStaticPaths() {
	const groups = groupPosts((await getCollection("blog")).filter((post) => !post.data.draft));

	return groups.map((group) => ({
		params: { group: group.slug },
		props: { group },
	}));
}

type Props = {
	group: BlogGroup;
};

const { group } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${group.label} · Blog · ${SITE_TITLE}`}
			description={`${group.label} folder with ${group.posts.length} blog ${group.posts.length === 1 ? "post" : "posts"}.`}
		/>
	</head>
	<body>
		<Header />
		<main class="page-shell">
			<section class="page-hero">
				<p class="eyebrow">Folder</p>
				<h1>{group.label}</h1>
				<p class="lead">
					{group.posts.length} {group.posts.length === 1 ? "post" : "posts"} collected under the same
					project thread.
				</p>
				<div class="page-actions">
					<a class="button-link" href="/blog">All folders</a>
					<a class="button-link secondary" href={getPostHref(group.posts[0])}>
						Start with {group.posts[0]?.data.title}
					</a>
				</div>
			</section>

			<section class="page-section" aria-label={`${group.label} posts`}>
				<ul class="post-grid">
					{
						group.posts.map((post) => (
							<li>
								<a class="post-card" href={getPostHref(post)}>
									<p class="post-meta">
										{group.label} · {post.data.order}. <FormattedDate date={post.data.pubDate} />
									</p>
									<h2>{post.data.title}</h2>
									<p>{post.data.description}</p>
									{post.data.tags.length > 0 && (
										<div class="tag-row" aria-label="Tags">
											{post.data.tags.map((tag) => (
												<span class="tag-pill">{tag}</span>
											))}
										</div>
									)}
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
