---
import { getCollection } from "astro:content";
import PostRow from "../../../components/PostRow.astro";
import Base from "../../../layouts/Base.astro";
import { formatDate, getPublishedPosts, groupPosts, seedFor, type BlogGroup } from "../../../utils/blog";
import { estimateReadingTime } from "../../../utils/readingTime";

export async function getStaticPaths() {
	const groups = groupPosts(getPublishedPosts(await getCollection("blog")));
	return groups.map((group) => ({ params: { group: group.slug }, props: { group } }));
}

interface Props {
	group: BlogGroup;
}

const { group } = Astro.props;
const dates = group.posts.map((post) => post.data.pubDate.valueOf());
const from = formatDate(new Date(Math.min(...dates)));
const to = formatDate(new Date(Math.max(...dates)));
const count = String(group.posts.length).padStart(2, "0");
---

<Base title={group.label} description={`${group.posts.length} notes filed under ${group.label}.`}>
	<div class="page wrap">
		<header class="series-head">
			<div>
				<p class="label crumbs" data-reveal>
					<a href="/blog/">Writing</a> <span aria-hidden="true">/</span> Series
				</p>
				<h1 class="page-title" data-reveal="words">{group.label}</h1>
				<dl class="series-meta label" data-reveal data-delay="0.3">
					<div>
						<dt>Notes</dt>
						<dd>{count}</dd>
					</div>
					<div>
						<dt>{from === to ? "Written" : "Span"}</dt>
						<dd>{from === to ? from : `${from} — ${to}`}</dd>
					</div>
					<div>
						<dt>Seed</dt>
						<dd>{String(seedFor(group.slug)).padStart(5, "0")}</dd>
					</div>
				</dl>
			</div>
			<div class="sheet series-cover" data-reveal data-delay="0.15">
				<canvas data-cover={seedFor(group.slug)} aria-hidden="true"></canvas>
			</div>
		</header>

		<section aria-label="Notes in this series">
			<p class="label tracklist">Read in order</p>
			<div class="rows">
				{
					group.posts.map((post, index) => (
						<PostRow
							post={post}
							index={index + 1}
							detail
							aside={estimateReadingTime(post.body ?? "").replace(" read", "")}
						/>
					))
				}
			</div>
		</section>
	</div>
</Base>

<style>
	.series-head {
		display: grid;
		grid-template-columns: minmax(0, 1fr) clamp(240px, 34vw, 520px);
		align-items: end;
		gap: clamp(28px, 5vw, 80px);
		padding-bottom: clamp(48px, 7vw, 104px);
	}

	.crumbs {
		padding-bottom: 28px;
	}

	.crumbs a:hover {
		color: var(--fg);
	}

	.series-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 18px 40px;
		margin-top: clamp(28px, 4vw, 52px);
	}

	.series-meta dt {
		color: var(--fg-3);
	}

	.series-meta dd {
		margin-top: 6px;
		color: var(--fg);
	}

	.series-cover {
		aspect-ratio: 1;
	}

	.tracklist {
		padding-bottom: 14px;
	}

	@media (max-width: 760px) {
		.series-head {
			grid-template-columns: 1fr;
		}

		.series-cover {
			order: -1;
			width: min(70%, 320px);
		}
	}
</style>
