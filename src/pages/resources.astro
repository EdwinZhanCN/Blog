---
import Base from "../layouts/Base.astro";

type Resource = {
	title: string;
	description: string;
	href: string;
	category: string;
	fileType: string;
	size?: string;
	updated?: string;
};

// Add a file here and it appears on the shelf.
const resources: Resource[] = [
	{
		title: "Enhanced Vanilla Minecraft Modpack",
		description: "A Minecraft server modpack for the Enhanced Vanilla setup.",
		href: "https://edwinzhan.space/Ehanced-Vanilla.mrpack",
		category: "Minecraft Server",
		fileType: "MRPACK",
	},
];
---

<Base title="Resources" description="Downloadable resources, project files, and external artifacts linked from the blog.">
	<div class="page wrap">
		<header class="page-head">
			<p class="label" data-reveal>Resources · {String(resources.length).padStart(2, "0")} on the shelf</p>
			<h1 class="page-title" data-reveal="words">Take <span class="serif">one.</span></h1>
			<p class="page-lede" data-reveal data-delay="0.3">Files and artifacts that belong to the notes, kept where you can reach them.</p>
		</header>

		<ul class="shelf">
			{
				resources.map((resource, index) => (
					<li data-reveal>
						<a class="shelf-item" href={resource.href} download>
							<span class="label">{String(index + 1).padStart(2, "0")}</span>
							<span>
								<span class="shelf-title">{resource.title}</span>
								<span class="shelf-desc">{resource.description}</span>
							</span>
							<span class="label">
								{resource.category}
								{resource.size && ` · ${resource.size}`}
								{resource.updated && ` · ${resource.updated}`}
							</span>
							<span class="shelf-get">
								<span class="label">{resource.fileType}</span>
								<span class="shelf-arrow" aria-hidden="true">↓</span>
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</Base>

<style>
	.shelf {
		border-top: 1px solid var(--line-strong);
	}

	.shelf-item {
		display: grid;
		grid-template-columns: 3.5rem minmax(0, 1fr) 12rem auto;
		align-items: center;
		column-gap: clamp(12px, 2vw, 28px);
		padding: clamp(22px, 3vw, 40px) 0;
		border-bottom: 1px solid var(--line);
	}

	.shelf-title {
		display: block;
		font-size: clamp(1.375rem, 2.8vw, 2.5rem);
		font-weight: 600;
		line-height: 1.08;
		letter-spacing: -0.04em;
		text-wrap: balance;
	}

	.shelf-desc {
		display: block;
		margin-top: 8px;
		color: var(--fg-2);
	}

	.shelf-get {
		display: flex;
		align-items: center;
		gap: 14px;
	}

	.shelf-arrow {
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		background: var(--ink);
		color: var(--paper);
		font-size: 1.125rem;
		transition: transform 0.6s var(--ease-out);
	}

	.shelf-item:hover .shelf-arrow {
		transform: translateY(5px);
	}

	@media (max-width: 860px) {
		.shelf-item {
			grid-template-columns: 2.25rem minmax(0, 1fr) auto;
			row-gap: 10px;
		}

		.shelf-item > .label:nth-child(3) {
			grid-column: 2;
			grid-row: 2;
		}

		.shelf-get {
			grid-row: 1;
			grid-column: 3;
		}
	}
</style>
