---
import { getCollection } from "astro:content";
import PostRow from "../components/PostRow.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import Base from "../layouts/Base.astro";
import {
	getGroupHref,
	getPostGroupName,
	getPostHref,
	getPublishedPosts,
	groupPosts,
	seedFor,
	sortPostsByDate,
	splitTitle,
} from "../utils/blog";

const posts = sortPostsByDate(getPublishedPosts(await getCollection("blog")));
const groups = groupPosts(posts);
// The newest note from each series first, so the front page shows the breadth, then whatever is next.
const leads = groups.map((group) => posts.find((post) => getPostGroupName(post) === group.name)!);
const latest = [...leads, ...posts.filter((post) => !leads.includes(post))].slice(0, 6);
const newest = latest[0];
// The series hang in two columns, one nearer than the other.
const columns = [0, 1].map((side) => groups.filter((_, index) => index % 2 === side));
const DEPTHS = ["0.93", "1.09"];
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION} field>
	<section class="hero" data-hero data-scene="hero">
		<div class="hero-top wrap blend" data-depth="0.86">
			<p class="label" data-reveal data-delay="0.9">Notebook of Edwin Zhan</p>
			<p class="label" data-reveal data-delay="0.9">N° <span data-seed>00000</span></p>
		</div>

		<div class="hero-main wrap blend">
			<h1 class="hero-title" data-reveal="words" data-delay="0.25">
				At the <br class="br-narrow" />crossroads <br class="br-wide" />of <br class="br-narrow" /><em
					class="serif">humanity</em
				> and<br />
				<span class="hero-tech">technology.</span>
			</h1>
			<div class="hero-meta label" data-reveal data-delay="1.6">
				<button type="button" data-repaint aria-label="Paint this page again from a new seed">
					Repaint <kbd>R</kbd>
				</button>
				<span class="hero-scroll">Scroll</span>
			</div>
		</div>
	</section>

	<section class="section wrap lane" aria-labelledby="now" data-scene="lane">
		<span class="lane-void" data-void aria-hidden="true"></span>
		<h2 class="now-label" id="now">
			<span class="label blend">01 — Now</span><span class="now-dot" aria-hidden="true"></span>
		</h2>
		<p class="statement blend" data-scrub>
			Software for machines that live at home: inference that runs locally, photo libraries that stay
			yours, agents that remember.
		</p>
		<dl class="facts blend">
			<div data-reveal>
				<dt class="label">Building</dt>
				<dd>
					{
						groups
							.filter((group) => ["lumen", "lumilio-photos"].includes(group.slug))
							.map((group) => <a href={getGroupHref(group.name)}>{group.label}</a>)
					}
				</dd>
			</div>
			<div data-reveal data-delay="0.08">
				<dt class="label">Thinking about</dt>
				<dd>Fast software, distributed systems, memory for agents</dd>
			</div>
			{
				newest && (
					<div data-reveal data-delay="0.16">
						<dt class="label">Latest note</dt>
						<dd>
							<a href={getPostHref(newest)}>{splitTitle(newest.data.title).main}</a>
						</dd>
					</div>
				)
			}
		</dl>
	</section>

	<section class="section wrap lane" aria-labelledby="writing" data-scene="lane">
		<div class="section-head blend">
			<h2 class="label" id="writing">02 — Writing</h2>
			<a class="label arrow-link" href="/blog/">All {posts.length} notes <span aria-hidden="true">→</span></a>
		</div>
		<div class="rows blend">
			{latest.map((post, index) => <PostRow post={post} index={index + 1} />)}
		</div>
	</section>

	<section class="section wrap" aria-labelledby="series" data-scene="series">
		<div class="section-head blend">
			<h2 class="label" id="series">03 — Series</h2>
			<p class="label">{String(groups.length).padStart(2, "0")}</p>
		</div>
		<div class="hang">
			{
				columns.map((column, side) => (
					<div class="hang-col" data-depth={DEPTHS[side]}>
						{column.map((group) => (
							<a class="tile" href={getGroupHref(group.name)} data-reveal>
								<div class="sheet">
									<canvas data-cover={seedFor(group.slug)} data-window aria-hidden="true" />
								</div>
								<div class="tile-text blend">
									<h3 class="tile-name">{group.label}</h3>
									<p class="tile-count">
										{String(group.posts.length).padStart(2, "0")} {group.posts.length === 1 ? "note" : "notes"}
									</p>
								</div>
							</a>
						))}
					</div>
				))
			}
		</div>
	</section>
</Base>

<style>
	/* ── Hero ───────────────────────────────────────────────────────────── */

	.hero {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-height: 100svh;
		padding-top: calc(var(--nav-top) + var(--nav-h) + 22px);
		padding-bottom: clamp(20px, 3vw, 36px);
	}

	.hero-top {
		display: flex;
		justify-content: space-between;
		gap: 16px;
	}

	.hero-top .label,
	.hero-meta {
		color: inherit;
	}

	.hero-title {
		font-size: clamp(2.75rem, 8.6vw, 9.25rem);
		font-weight: 600;
		line-height: 0.93;
		letter-spacing: -0.052em;
	}

	.hero-title em {
		font-weight: 380;
		letter-spacing: -0.045em;
		padding-right: 0.04em;
	}

	/* "humanity" is set by hand, "technology" by machine. */
	.hero-tech {
		font-family: var(--font-mono);
		font-weight: 420;
		font-size: 0.84em;
		letter-spacing: -0.085em;
	}

	.br-narrow {
		display: none;
	}

	@media (max-width: 640px) {
		.br-narrow {
			display: inline;
		}

		.br-wide {
			display: none;
		}
	}

	.hero-meta {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 22px;
		margin-top: clamp(24px, 3.4vw, 48px);
	}

	.hero-meta button {
		text-transform: inherit;
		letter-spacing: inherit;
	}

	.hero-meta kbd {
		display: inline-grid;
		place-items: center;
		width: 18px;
		height: 18px;
		margin-left: 6px;
		border: 1px solid currentColor;
		border-radius: 4px;
		font: inherit;
		font-size: 0.625rem;
		letter-spacing: 0;
	}

	.hero-scroll {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.hero-scroll::after {
		content: "";
		width: 1px;
		height: 34px;
		background: currentColor;
		transform-origin: top;
		animation: drip 2.6s var(--ease-in-out) infinite;
	}

	@keyframes drip {
		0% {
			transform: scaleY(0);
		}
		55% {
			transform: scaleY(1);
			transform-origin: top;
		}
		56% {
			transform-origin: bottom;
		}
		100% {
			transform: scaleY(0);
			transform-origin: bottom;
		}
	}

	@media (max-width: 860px) {
		.hero-meta button {
			display: none;
		}
	}

	/* ── The lane: text keeps to nine columns, the painting to the other three ── */

	.lane {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: clamp(16px, 2vw, 28px);
	}

	.lane > * {
		grid-column: 1 / span 9;
	}

	/* Marks the middle of the margin, so the painting knows where it is. */
	.lane > .lane-void {
		grid-column: 10 / -1;
		grid-row: 1;
		height: 0;
	}

	@media (max-width: 860px) {
		.lane > * {
			grid-column: 1 / -1;
		}

		.lane > .lane-void {
			display: none;
		}
	}

	/* ── Now ────────────────────────────────────────────────────────────── */

	.now-label {
		display: flex;
		align-items: center;
		gap: 8px;
		padding-bottom: 28px;
		line-height: 1;
	}

	/* The page's one vermilion mark: this part is current. */
	.now-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--seal);
		animation: breathe 3.2s ease-in-out infinite;
	}

	@keyframes breathe {
		50% {
			opacity: 0.35;
		}
	}

	.statement {
		max-width: 22em;
		font-size: clamp(1.75rem, 4.1vw, 3.75rem);
		font-weight: 600;
		line-height: 1.06;
		letter-spacing: -0.042em;
	}

	.facts {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 28px clamp(16px, 2vw, 28px);
		margin-top: clamp(48px, 7vw, 104px);
	}

	.facts > div {
		padding-top: 14px;
		border-top: 1px solid var(--line-strong);
	}

	.facts dd {
		margin-top: 10px;
		font-size: 1.0625rem;
		line-height: 1.35;
		letter-spacing: -0.015em;
		text-wrap: balance;
	}

	.facts a {
		background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat;
	}

	.facts a:hover {
		color: var(--fg-2);
	}

	.facts a + a::before {
		content: ", ";
	}

	@media (max-width: 700px) {
		.facts {
			grid-template-columns: 1fr;
		}
	}
</style>
