---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { formatGroupName, getPostGroupName, getPostHref } from "../utils/blog";

const posts = (await getCollection("blog")).filter((post) => !post.data.draft);
const dateFormatter = new Intl.DateTimeFormat("en-us", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
});
const noteSlots = [
    { left: 0, top: 9, width: 32, rotation: [-8, -3] },
    { left: 33, top: 1, width: 31, rotation: [2, 7] },
    { left: 65, top: 12, width: 30, rotation: [-5, 4] },
    { left: 11, top: 45, width: 34, rotation: [3, 9] },
    { left: 49, top: 42, width: 36, rotation: [-9, -3] },
];
const noteTints = ["#dff3ff", "#fff0c9", "#e8f7dd", "#ffe0ea", "#e7e6ff"];
const featuredPlaylists = [
    {
        id: "2026-s",
        side: "A",
        src: "https://embed.music.apple.com/us/playlist/2026-s/pl.u-pMyllEmcWBV25My",
        title: "2026's",
        year: "2026",
    },
    {
        id: "2025-s",
        side: "B",
        src: "https://embed.music.apple.com/cn/playlist/2025-s/pl.u-qxylKqDI3jagdpJ?l=en",
        title: "2025's",
        year: "2025",
    },
] as const;
const defaultPlaylist = featuredPlaylists[0];

function randomBetween(min: number, max: number) {
    return min + Math.random() * (max - min);
}

function shuffle<T>(items: T[]) {
    const result = [...items];

    for (let index = result.length - 1; index > 0; index -= 1) {
        const swapIndex = Math.floor(Math.random() * (index + 1));
        [result[index], result[swapIndex]] = [result[swapIndex], result[index]];
    }

    return result;
}

const threadPosts = posts.map((post) => ({
    description: post.data.description,
    displayDate: dateFormatter.format(post.data.pubDate),
    groupLabel: formatGroupName(getPostGroupName(post)),
    href: getPostHref(post),
    pubDate: post.data.pubDate.toISOString(),
    title: post.data.title,
}));

const currentThreads = shuffle(threadPosts)
    .slice(0, 5)
    .map((thread, index) => {
        const slot = noteSlots[index % noteSlots.length];
        const [minRotation, maxRotation] = slot.rotation;

        return {
            thread,
            style: [
                `--note-left: ${randomBetween(slot.left - 1.8, slot.left + 1.8).toFixed(2)}%`,
                `--note-top: ${randomBetween(slot.top - 2.2, slot.top + 2.2).toFixed(2)}%`,
                `--note-width: ${slot.width}%`,
                `--note-rotate: ${randomBetween(minRotation, maxRotation).toFixed(2)}deg`,
                `--note-z: ${index + 1}`,
                `--note-tint: ${noteTints[index % noteTints.length]}`,
            ].join("; "),
        };
    });
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header />
        <main class="page-shell">
            <section class="page-hero">
                <p class="eyebrow">Personal Blog</p>
                <h1>Where are the crossroads of humanity and tech?</h1>
                <div class="page-actions">
                    <a class="button-link" href="/blog">Read the blog</a>
                    <a class="button-link secondary" href="/about">About</a>
                </div>
            </section>

            <section
                class="page-section current-threads-section"
                aria-labelledby="current-threads-heading"
            >
                <div class="section-header-row">
                    <div>
                        <p class="eyebrow">Current Threads</p>
                        <h2
                            id="current-threads-heading"
                            class="section-heading"
                        >
                            Notes on the desk.
                        </h2>
                    </div>
                    <button
                        class="button-link secondary refresh-threads-button"
                        type="button"
                        data-refresh-threads
                    >
                        Refresh
                    </button>
                </div>
                <ul class="thread-desk">
                    {
                        currentThreads.map(({ thread, style }) => (
                            <li style={style}>
                                <a class="thread-note-card" href={thread.href}>
                                    <p class="post-meta">
                                        {thread.groupLabel} ·{" "}
                                        <time datetime={thread.pubDate}>
                                            {thread.displayDate}
                                        </time>
                                    </p>
                                    <h3>{thread.title}</h3>
                                    <p>{thread.description}</p>
                                    <span class="thread-note-link">
                                        Read note
                                    </span>
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </section>

            <section
                class="page-section playlist-section"
                aria-labelledby="featured-playlist-heading"
            >
                <div class="playlist-shell">
                    <div class="playlist-vinyl-panel">
                        <p class="eyebrow">Featured Playlist</p>
                        <h2
                            id="featured-playlist-heading"
                            class="section-heading"
                        >
                            Flip the record.
                        </h2>
                        <button
                            class="playlist-vinyl-button"
                            type="button"
                            data-playlist-toggle
                            aria-label={`Flip to ${featuredPlaylists[1].title}`}
                        >
                            <span class="playlist-vinyl-stack" aria-hidden="true">
                                <span class="playlist-sleeve"></span>
                                <span class="playlist-vinyl-disc">
                                    <span class="playlist-vinyl-rings"></span>
                                    <span class="playlist-vinyl-center">
                                        <span data-playlist-side>
                                            Side {defaultPlaylist.side}
                                        </span>
                                        <strong data-playlist-year>
                                            {defaultPlaylist.year}
                                        </strong>
                                    </span>
                                </span>
                            </span>
                        </button>
                        <p class="playlist-mini-copy">
                            <span data-playlist-current-title>
                                {defaultPlaylist.title}
                            </span>
                            <span>Tap the vinyl to switch sides.</span>
                        </p>
                    </div>
                    <div class="playlist-frame-wrap">
                        <div class="playlist-player-shell">
                            <p class="playlist-player-meta">
                                <span data-playlist-meta-side>
                                    Side {defaultPlaylist.side}
                                </span>
                                <strong data-playlist-meta-title>
                                    {defaultPlaylist.title}
                                </strong>
                            </p>
                            <iframe
                                title={`Apple Music playlist: ${defaultPlaylist.title}`}
                                allow="autoplay *; encrypted-media *;"
                                frameborder="0"
                                height="450"
                                loading="lazy"
                                style="width:100%;max-width:660px;overflow:hidden;background:transparent;"
                                sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation"
                                src={defaultPlaylist.src}
                                data-playlist-frame
                            ></iframe>
                        </div>
                    </div>
                </div>
            </section>
        </main>
        <Footer />
        <script
            define:vars={{ featuredPlaylists, noteSlots, noteTints, threadPosts }}
        >
            const desk = document.querySelector(".thread-desk");
            const refreshButton = document.querySelector(
                "[data-refresh-threads]",
            );
            const playlistFrame = document.querySelector("[data-playlist-frame]");
            const playlistToggle = document.querySelector(
                "[data-playlist-toggle]",
            );
            const playlistSide = document.querySelector("[data-playlist-side]");
            const playlistYear = document.querySelector("[data-playlist-year]");
            const playlistCurrentTitle = document.querySelector(
                "[data-playlist-current-title]",
            );
            const playlistMetaSide = document.querySelector(
                "[data-playlist-meta-side]",
            );
            const playlistMetaTitle = document.querySelector(
                "[data-playlist-meta-title]",
            );
            let activePlaylistIndex = 0;

            function randomBetween(min, max) {
                return min + Math.random() * (max - min);
            }

            function shuffle(items) {
                const result = [...items];

                for (let index = result.length - 1; index > 0; index -= 1) {
                    const swapIndex = Math.floor(Math.random() * (index + 1));
                    [result[index], result[swapIndex]] = [
                        result[swapIndex],
                        result[index],
                    ];
                }

                return result;
            }

            function getNoteStyle(index) {
                const slot = noteSlots[index % noteSlots.length];
                const [minRotation, maxRotation] = slot.rotation;

                return [
                    `--note-left: ${randomBetween(slot.left - 1.8, slot.left + 1.8).toFixed(2)}%`,
                    `--note-top: ${randomBetween(slot.top - 2.2, slot.top + 2.2).toFixed(2)}%`,
                    `--note-width: ${slot.width}%`,
                    `--note-rotate: ${randomBetween(minRotation, maxRotation).toFixed(2)}deg`,
                    `--note-z: ${index + 1}`,
                    `--note-tint: ${noteTints[index % noteTints.length]}`,
                ].join("; ");
            }

            function createThreadCard(thread, index) {
                const item = document.createElement("li");
                const link = document.createElement("a");
                const meta = document.createElement("p");
                const time = document.createElement("time");
                const title = document.createElement("h3");
                const description = document.createElement("p");
                const readNote = document.createElement("span");

                item.setAttribute("style", getNoteStyle(index));
                link.className = "thread-note-card";
                link.href = thread.href;
                meta.className = "post-meta";
                time.dateTime = thread.pubDate;
                time.textContent = thread.displayDate;
                title.textContent = thread.title;
                description.textContent = thread.description;
                readNote.className = "thread-note-link";
                readNote.textContent = "Read note";

                meta.append(thread.groupLabel, " · ", time);
                link.append(meta, title, description, readNote);
                item.append(link);

                return item;
            }

            refreshButton?.addEventListener("click", () => {
                if (!desk) return;

                const nextThreads = shuffle(threadPosts).slice(0, 5);
                desk.replaceChildren(
                    ...nextThreads.map((thread, index) =>
                        createThreadCard(thread, index),
                    ),
                );
            });

            function setActivePlaylist(index) {
                const nextPlaylist = featuredPlaylists[index];
                const upcomingPlaylist =
                    featuredPlaylists[(index + 1) % featuredPlaylists.length];

                if (!nextPlaylist || !playlistFrame) return;

                activePlaylistIndex = index;
                playlistFrame.src = nextPlaylist.src;
                playlistFrame.title = `Apple Music playlist: ${nextPlaylist.title}`;
                playlistToggle?.classList.toggle("is-b-side", index === 1);
                playlistToggle?.setAttribute(
                    "aria-label",
                    `Flip to ${upcomingPlaylist.title}`,
                );

                if (playlistSide) {
                    playlistSide.textContent = `Side ${nextPlaylist.side}`;
                }

                if (playlistYear) {
                    playlistYear.textContent = nextPlaylist.year;
                }

                if (playlistCurrentTitle) {
                    playlistCurrentTitle.textContent = nextPlaylist.title;
                }

                if (playlistMetaSide) {
                    playlistMetaSide.textContent = `Side ${nextPlaylist.side}`;
                }

                if (playlistMetaTitle) {
                    playlistMetaTitle.textContent = nextPlaylist.title;
                }
            }

            playlistToggle?.addEventListener("click", () => {
                const nextIndex =
                    (activePlaylistIndex + 1) % featuredPlaylists.length;
                setActivePlaylist(nextIndex);
            });
        </script>
    </body>
</html>
