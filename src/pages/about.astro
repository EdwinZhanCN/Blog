---
import { AUTHOR } from "../consts";
import Base from "../layouts/Base.astro";
import { seedFor } from "../utils/blog";

const portraitSeed = seedFor(AUTHOR.fullName);

const bio = [
	{ term: "Name", detail: AUTHOR.fullName },
	{ term: "Studying", detail: "Computer Science, RPI" },
	{ term: "Programming", detail: "Five years, so far" },
	{ term: "Drawn to", detail: "Computer science, cognitive science, art" },
];

const interests = [
	"High-performance software and distributed systems.",
	"Home-native machine learning infrastructure, for constrained local environments.",
	"ReAct agents with memory systems.",
];

const stack = ["Go", "Python", "TypeScript", "Swift", "Rust", "React", "PyTorch", "FastAPI", "Docker", "Node.js", "WebAssembly"];
---

<Base title="About" description={`About ${AUTHOR.name} and the notes collected on this site.`}>
	<div class="page wrap">
		<header class="page-head about-head">
			<div class="about-intro">
				<p class="label" data-reveal>About</p>
				<h1 class="page-title" data-reveal="words">Hi.</h1>
				<p class="page-lede" data-reveal data-delay="0.3">
					I’m Zihao. Edwin, in English. I write software, and before that, I drew.
				</p>
			</div>
			<figure class="portrait" data-reveal data-delay="0.15">
				<div class="sheet"><canvas data-cover={portraitSeed} aria-hidden="true"></canvas></div>
				<figcaption class="label">Self-portrait · grown from my name · seed {String(portraitSeed).padStart(5, "0")}</figcaption>
			</figure>
		</header>

		<section class="split block" aria-labelledby="bio">
			<h2 class="label split-label" id="bio">Bio</h2>
			<dl class="split-body ledger">
				{
					bio.map((row) => (
						<div data-reveal>
							<dt class="label">{row.term}</dt>
							<dd>{row.detail}</dd>
						</div>
					))
				}
				<div data-reveal>
					<dt class="label">Write to me</dt>
					<dd><a class="arrow-link" href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a></dd>
				</div>
			</dl>
		</section>

		<section class="split block" aria-labelledby="interests">
			<h2 class="label split-label" id="interests">Current interests</h2>
			<ol class="split-body interests">
				{
					interests.map((item, index) => (
						<li data-reveal>
							<span class="label">{String(index + 1).padStart(2, "0")}</span>
							{item}
						</li>
					))
				}
			</ol>
		</section>

		<section class="split block" aria-labelledby="how">
			<h2 class="label split-label" id="how">How I write</h2>
			<div class="split-body essay">
				<p data-scrub>
					The posts are intentionally close to the projects. Most notes are written locally in Obsidian and
					published here with Astro. Some are sketches. Some belong to projects I shelved. They stay.
				</p>
			</div>
		</section>
	</div>

	<section class="marquee" aria-label={`Works with ${stack.join(", ")}`}>
		<div class="marquee-track" aria-hidden="true">
			{
				[0, 1].map(() => (
					<div class="marquee-run">
						{stack.map((name, index) => (
							<span class:list={{ serif: index % 3 === 1 }}>{name}</span>
						))}
					</div>
				))
			}
		</div>
	</section>

	<div class="wrap">
		<section class="split block" aria-labelledby="site">
			<h2 class="label split-label" id="site">This site</h2>
			<div class="split-body colophon">
				<div class="colophon-text">
					<p data-reveal>
						<strong>The ink is me.</strong> It moves, it makes a mess, and it’s the part you actually see.
					</p>
					<p data-reveal>
						<strong>The circle is what I leave untouched.</strong> An ideal I hold, not one I’m in a hurry to
						become. It’s only visible because of what moves around it.
					</p>
					<p data-reveal>
						<strong>The layout is strict; the painting isn’t.</strong> Each visit grows a new one from a random
						seed, and every note and series grows its own from its name. I like control. This is where I let
						accident in.
					</p>
					<p class="label colophon-credits" data-reveal>
						Inter · Newsreader · JetBrains Mono<br />
						Astro · Motion · one WebGL fragment shader
					</p>
				</div>
				<figure class="reserved" data-reveal>
					<div class="reserved-frame"></div>
					<figcaption class="label">
						<span class="seal" aria-hidden="true"></span>
						Reserved. For a drawing of my own, when one says it right.
					</figcaption>
				</figure>
			</div>
		</section>
	</div>
</Base>

<style>
	.about-head {
		grid-template-columns: minmax(0, 1fr) clamp(220px, 30vw, 440px);
		align-items: end;
		gap: clamp(28px, 5vw, 80px);
	}

	.about-intro {
		display: grid;
		gap: 28px;
	}

	.portrait .sheet {
		aspect-ratio: 1;
	}

	.portrait figcaption {
		margin-top: 10px;
		color: var(--fg-3);
	}

	@media (max-width: 760px) {
		.about-head {
			grid-template-columns: 1fr;
		}

		.portrait {
			order: -1;
			width: min(62%, 280px);
		}
	}

	.block {
		padding-block: clamp(40px, 6vw, 88px);
		border-top: 1px solid var(--line-strong);
	}

	.ledger > div {
		display: grid;
		grid-template-columns: minmax(7rem, 1fr) minmax(0, 3fr);
		align-items: baseline;
		gap: 16px;
		padding-block: 16px;
		border-bottom: 1px solid var(--line);
	}

	.ledger > div:first-child {
		padding-top: 0;
	}

	.ledger dd {
		font-size: clamp(1.25rem, 2.2vw, 1.75rem);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.03em;
	}

	.interests li {
		display: grid;
		grid-template-columns: 3rem minmax(0, 1fr);
		align-items: baseline;
		max-width: 24em;
		font-size: clamp(1.5rem, 3.2vw, 2.75rem);
		font-weight: 600;
		line-height: 1.08;
		letter-spacing: -0.04em;
		text-wrap: balance;
	}

	.interests li + li {
		margin-top: 0.7em;
	}

	.essay p {
		max-width: 22em;
		font-size: clamp(1.5rem, 3.2vw, 2.75rem);
		font-weight: 600;
		line-height: 1.1;
		letter-spacing: -0.04em;
	}

	/* ── Stack: a line of type passing by ───────────────────────────────── */

	.marquee {
		overflow: hidden;
		padding-block: clamp(28px, 4vw, 56px);
		border-top: 1px solid var(--line-strong);
		-webkit-mask: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
		mask: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
	}

	.marquee-track {
		display: flex;
		width: max-content;
		animation: pass 46s linear infinite;
	}

	.marquee-run {
		display: flex;
		align-items: baseline;
	}

	.marquee-run span {
		display: inline-flex;
		align-items: center;
		font-size: clamp(2.5rem, 7vw, 6.5rem);
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.05em;
		white-space: nowrap;
	}

	.marquee-run span.serif {
		font-weight: 400;
		letter-spacing: -0.04em;
	}

	.marquee-run span::after {
		content: "";
		width: 0.14em;
		height: 0.14em;
		margin-inline: 0.42em;
		background: var(--fg);
	}

	@keyframes pass {
		to {
			transform: translate3d(-50%, 0, 0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee-track {
			animation: none;
		}
	}

	/* ── Colophon ───────────────────────────────────────────────────────── */

	.colophon {
		display: grid;
		grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
		align-items: start;
		gap: clamp(32px, 5vw, 80px);
	}

	.colophon-text p {
		max-width: 30em;
		font-size: clamp(1.125rem, 1.7vw, 1.375rem);
		line-height: 1.4;
		letter-spacing: -0.02em;
		color: var(--fg-2);
	}

	.colophon-text p + p {
		margin-top: 1.3em;
	}

	.colophon-text strong {
		color: var(--fg);
		font-weight: 600;
	}

	.colophon-text .colophon-credits {
		margin-top: 3em;
		font-size: 0.6875rem;
		line-height: 1.9;
		letter-spacing: 0.08em;
	}

	.reserved-frame {
		aspect-ratio: 4 / 5;
		box-shadow: inset 0 0 0 1px var(--line-strong);
	}

	.reserved figcaption {
		display: flex;
		align-items: baseline;
		gap: 10px;
		margin-top: 12px;
		line-height: 1.6;
	}

	.reserved .seal {
		flex: none;
		width: 9px;
		height: 9px;
	}

	@media (max-width: 860px) {
		.colophon {
			grid-template-columns: 1fr;
		}

		.reserved {
			max-width: 320px;
		}
	}
</style>
