---
import { AUTHOR, SOCIALS } from "../consts";

interface Props {
	/** On the home page the footer is a full screen and the ink comes back under it. */
	tall?: boolean;
}

const { tall = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class:list={["footer wrap", { "is-tall blend": tall }]} data-footer>
	<div>
		<p class="footer-hello" data-reveal="words">
			If we’ve met, hello <em class="serif">again.</em><br />
			If we haven’t yet, hello.
		</p>
		<a class="footer-mail" href={`mailto:${AUTHOR.email}`} data-reveal>{AUTHOR.email}</a>
	</div>
	<div class="footer-base label">
		<span>&copy; {year} {AUTHOR.name}</span>
		<ul>
			{
				SOCIALS.map((item) => (
					<li>
						<a href={item.href} {...item.href.startsWith("http") ? { target: "_blank", rel: "me noopener noreferrer" } : {}}>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
		{tall && <span data-seed-label>Painted once</span>}
	</div>
</footer>
