---
const today = new Date();
---

<footer class="site-footer">
	<div class="site-footer-inner">
		<span>&copy; {today.getFullYear()} Edwin Zhan.</span>
		<span>Built for notes that age well.</span>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--site-border);
		color: var(--site-soft);
		margin-top: 40px;
	}

	.site-footer-inner {
		align-items: center;
		display: flex;
		flex-wrap: wrap;
		font-size: 0.9rem;
		gap: 10px 18px;
		justify-content: space-between;
		margin: 0 auto;
		max-width: 1180px;
		padding: 28px clamp(20px, 5vw, 56px) 46px;
	}
</style>
