---
import { AUTHOR, SOCIALS } from "../consts";

interface Props {
	/** On the home page the footer is a full screen, and the painting comes back whole under it. */
	tall?: boolean;
}

const { tall = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class:list={["footer wrap", { "is-tall blend": tall }]} data-scene={tall ? "footer" : undefined}>
	<a class="footer-mail" href={`mailto:${AUTHOR.email}`} data-reveal>{AUTHOR.email}</a>
	<div class="footer-base label">
		<span>&copy; {year} {AUTHOR.name}</span>
		<ul>
			{
				SOCIALS.map((item) => (
					<li>
						<a href={item.href} {...item.href.startsWith("http") ? { target: "_blank", rel: "me noopener noreferrer" } : {}}>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
		{tall && <span>N° <span data-seed>00000</span></span>}
	</div>
</footer>
