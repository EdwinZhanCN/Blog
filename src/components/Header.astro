---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
---

<header class="site-header">
	<nav class="site-nav" aria-label="Primary navigation">
		<a class="site-brand" href="/">{SITE_TITLE}</a>
		<div class="site-nav-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/resources">Resources</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="site-nav-actions">
			<a
				class="nav-icon-link"
				href="https://github.com/EdwinZhanCN"
				rel="me noopener noreferrer"
				target="_blank"
				aria-label="GitHub"
			>
				<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
					<path d="M12 2C6.48 2 2 6.58 2 12.24c0 4.52 2.86 8.35 6.84 9.71.5.1.68-.22.68-.49v-1.91c-2.78.62-3.37-1.22-3.37-1.22-.45-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .08 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.86.09-.66.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.93c.85 0 1.7.12 2.5.34 1.9-1.33 2.74-1.05 2.74-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.79-4.57 5.05.36.32.68.94.68 1.9v2.83c0 .27.18.59.69.49A10.1 10.1 0 0 0 22 12.24C22 6.58 17.52 2 12 2Z" />
				</svg>
			</a>
			<a
				class="nav-icon-link"
				href="https://space.bilibili.com/592046389"
				rel="me noopener noreferrer"
				target="_blank"
				aria-label="Bilibili"
			>
				<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
					<path d="m8 4 2 2" />
					<path d="m16 4-2 2" />
					<rect x="3.5" y="6.5" width="17" height="13" rx="3.5" />
					<path d="M9 12.5v2.2" />
					<path d="M15 12.5v2.2" />
				</svg>
			</a>
			<button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle color theme">
				<span class="sr-only" data-theme-toggle-label>Toggle color theme</span>
				<svg
					class="theme-icon theme-icon-moon"
					data-theme-icon="moon"
					viewBox="0 0 24 24"
					aria-hidden="true"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="M20.99 12.35A8.5 8.5 0 1 1 11.65 3.01 6.5 6.5 0 0 0 20.99 12.35Z" />
				</svg>
				<svg
					class="theme-icon theme-icon-sun"
					data-theme-icon="sun"
					hidden
					viewBox="0 0 24 24"
					aria-hidden="true"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<circle cx="12" cy="12" r="4" />
					<path d="M12 2v2" />
					<path d="M12 20v2" />
					<path d="m4.93 4.93 1.41 1.41" />
					<path d="m17.66 17.66 1.41 1.41" />
					<path d="M2 12h2" />
					<path d="M20 12h2" />
					<path d="m6.34 17.66-1.41 1.41" />
					<path d="m19.07 4.93-1.41 1.41" />
				</svg>
			</button>
		</div>
	</nav>
</header>

<script is:inline>
	(() => {
		function storedTheme() {
			try {
				return localStorage.getItem("blog-theme");
			} catch {
				return null;
			}
		}

		function applyTheme(theme, persist = true) {
			const nextTheme = theme === "dark" ? "dark" : "light";
			document.documentElement.dataset.theme = nextTheme;
			if (persist) {
				try {
					localStorage.setItem("blog-theme", nextTheme);
				} catch {
					// The visible theme can still change even if storage is unavailable.
				}
			}

			document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
				const label = button.querySelector("[data-theme-toggle-label]");
				const target = nextTheme === "dark" ? "Light" : "Dark";
				const iconToShow = nextTheme === "dark" ? "sun" : "moon";
				button.dataset.themeAction = target.toLowerCase();
				if (label) {
					label.textContent = `Switch to ${target.toLowerCase()} mode`;
				}
				button.querySelectorAll("[data-theme-icon]").forEach((icon) => {
					icon.toggleAttribute("hidden", icon.dataset.themeIcon !== iconToShow);
				});
				button.setAttribute("aria-label", `Switch to ${target.toLowerCase()} mode`);
			});
		}

		function syncThemeControls() {
			const theme =
				storedTheme() ||
				document.documentElement.dataset.theme ||
				(window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
			applyTheme(theme, false);
		}

		if (!window.__siteThemeNavigationReady) {
			window.__siteThemeNavigationReady = true;
			document.addEventListener("click", (event) => {
				const button = event.target.closest("[data-theme-toggle]");
				if (!button) {
					return;
				}
				applyTheme(document.documentElement.dataset.theme === "dark" ? "light" : "dark");
			});
			document.addEventListener("astro:page-load", syncThemeControls);
			document.addEventListener("astro:after-swap", syncThemeControls);
		}

		syncThemeControls();
	})();
</script>

<script is:inline>
	(() => {
		function syncActiveLinks() {
			const firstPath = location.pathname.split("/").filter(Boolean)[0] || "";
			document.querySelectorAll(".site-nav-links a").forEach((link) => {
				const href = new URL(link.getAttribute("href"), location.href).pathname;
				const linkFirstPath = href.split("/").filter(Boolean)[0] || "";
				const active = href === location.pathname || linkFirstPath === firstPath;
				link.classList.toggle("active", active);
			});
		}

		if (!window.__siteNavActiveReady) {
			window.__siteNavActiveReady = true;
			document.addEventListener("astro:page-load", syncActiveLinks);
			document.addEventListener("astro:after-swap", syncActiveLinks);
		}

		syncActiveLinks();
	})();
</script>

<script is:inline>
	(() => {
		if (window.__siteNavPrefetchReady) {
			return;
		}
		window.__siteNavPrefetchReady = true;

		document.addEventListener("pointerenter", (event) => {
			const link = event.target.closest(".site-nav a[href]");
			if (!link || link.origin !== location.origin || link.dataset.prefetched) {
				return;
			}
			link.dataset.prefetched = "true";
			const prefetch = document.createElement("link");
			prefetch.rel = "prefetch";
			prefetch.href = link.href;
			document.head.append(prefetch);
		});
	})();
</script>

<style>
	.site-header {
		background: color-mix(in srgb, var(--site-bg) 88%, transparent);
		backdrop-filter: blur(20px);
		border-bottom: 1px solid var(--site-border);
		position: sticky;
		top: 0;
		z-index: 20;
	}

	.site-nav {
		align-items: center;
		display: grid;
		gap: 16px;
		grid-template-columns: minmax(0, 1fr) auto auto;
		margin: 0 auto;
		max-width: 1180px;
		min-height: var(--site-header-height);
		padding: 0 clamp(20px, 5vw, 56px);
	}

	.site-brand {
		color: var(--site-heading);
		font-size: 0.96rem;
		font-weight: 760;
		letter-spacing: 0;
		overflow: hidden;
		text-decoration: none;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.site-nav-links {
		align-items: center;
		background: var(--site-surface);
		border: 1px solid var(--site-border);
		border-radius: 999px;
		display: inline-flex;
		gap: 2px;
		padding: 4px;
	}

	.site-nav-links :global(a) {
		border-radius: 999px;
		color: var(--site-muted);
		font-size: 0.88rem;
		font-weight: 700;
		line-height: 1;
		padding: 9px 13px;
		transition:
			background-color 160ms ease,
			color 160ms ease;
	}

	.site-nav-links :global(a:hover),
	.site-nav-links :global(a.active) {
		background: var(--site-active);
		color: var(--site-heading);
	}

	.site-nav-actions {
		align-items: center;
		display: inline-flex;
		gap: 8px;
	}

	.nav-icon-link {
		align-items: center;
		background: var(--site-surface);
		border: 1px solid var(--site-border);
		border-radius: 999px;
		color: var(--site-heading);
		display: inline-flex;
		flex: 0 0 auto;
		height: 42px;
		justify-content: center;
		text-decoration: none;
		transition:
			background-color 160ms ease,
			border-color 160ms ease,
			color 160ms ease;
		width: 42px;
	}

	.nav-icon-link:hover {
		background: var(--site-active);
		border-color: var(--site-border-strong);
		color: var(--site-heading);
	}

	.nav-icon-link svg {
		display: block;
		height: 18px;
		width: 18px;
	}

	.theme-toggle {
		appearance: none;
		align-items: center;
		background: var(--site-surface);
		border: 1px solid var(--site-border);
		border-radius: 999px;
		color: var(--site-heading);
		cursor: pointer;
		display: inline-flex;
		flex: 0 0 auto;
		height: 42px;
		justify-content: center;
		line-height: 0;
		overflow: hidden;
		padding: 0;
		transition:
			background-color 160ms ease,
			border-color 160ms ease,
			color 160ms ease;
		width: 42px;
	}

	.theme-toggle:hover {
		background: var(--site-active);
		border-color: var(--site-border-strong);
	}

	.theme-icon {
		display: block;
		flex: 0 0 auto;
		height: 18px;
		width: 18px;
	}

	.theme-icon[hidden] {
		display: none;
	}

	@media (max-width: 640px) {
		.site-nav {
			gap: 10px;
			grid-template-columns: 1fr auto;
			padding: 10px 16px;
		}

		.site-brand {
			grid-column: 1 / -1;
		}

		.site-nav-links {
			justify-self: start;
			max-width: 100%;
			overflow-x: auto;
		}

		.site-nav-links :global(a) {
			padding: 8px 11px;
		}

		.site-nav-actions {
			gap: 6px;
			justify-self: end;
		}

		.nav-icon-link,
		.theme-toggle {
			height: 38px;
			width: 38px;
		}
	}
</style>
